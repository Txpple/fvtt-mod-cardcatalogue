<div class="cc-finder">
  <label class="cc-search cc-finder-box">
    <i class="fa-solid fa-magnifying-glass" inert></i>
    <input type="search" name="find" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="cardcatalogue-scenes-finder-results" aria-autocomplete="list"
      placeholder="{{localize 'fvtt-mod-cardcatalogue.scenes.finder.placeholder'}}"
      aria-label="{{localize 'fvtt-mod-cardcatalogue.scenes.finder.title'}}">
    <kbd>Esc</kbd>
  </label>
  <ul class="cc-results" id="cardcatalogue-scenes-finder-results" role="listbox"></ul>
  <div class="cc-finder-foot">
    <span><kbd>↑</kbd> <kbd>↓</kbd> {{localize "fvtt-mod-cardcatalogue.scenes.finder.move"}}</span>
    <span><kbd>Enter</kbd> {{localize "fvtt-mod-cardcatalogue.scenes.finder.enterView"}}</span>
    <span><kbd>Shift</kbd> <kbd>Enter</kbd> {{localize "fvtt-mod-cardcatalogue.scenes.finder.shiftEnter"}}</span>
    <span><kbd>Ctrl</kbd> <kbd>Enter</kbd> {{localize "fvtt-mod-cardcatalogue.scenes.finder.ctrlEnter"}}</span>
  </div>
</div>
