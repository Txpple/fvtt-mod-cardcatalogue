<div class="cc-reader">
  <div class="cc-reader-body">
    {{#if showName}}{{#if name}}<h2 class="cc-reader-title" dir="auto">{{name}}</h2>{{/if}}{{/if}}
    {{#if isImage}}
    <figure class="cc-reader-figure">
      <img src="{{src}}" alt="{{name}}">
      {{#if caption}}<figcaption dir="auto">{{caption}}</figcaption>{{/if}}
    </figure>
    {{/if}}
    {{#if isVideo}}<video class="cc-reader-video" src="{{src}}" controls></video>{{/if}}
    {{#if html}}<div class="cc-reader-text">{{{html}}}</div>{{/if}}
    {{#if empty}}<p class="cc-reader-empty">{{localize "fvtt-mod-cardcatalogue.journal.reader.empty"}}</p>{{/if}}
  </div>
</div>
